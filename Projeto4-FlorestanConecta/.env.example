# ============================================================
# Florestan Conecta — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local (ele está no .gitignore).
# ============================================================

# ---------- IA ----------
# Provedor: gemini | deepseek | groq
IA_PROVIDER=gemini

# Google Gemini
# Onde conseguir: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
# Onde conseguir: https://platform.deepseek.com -> API Keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq
# Onde conseguir: https://console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

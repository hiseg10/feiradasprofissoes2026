# Provedor de IA: gemini | deepseek | groq
# Para diagnostico de imagem, recomenda-se o Gemini (visao).
IA_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Token opcional para o ESP32 enviar leituras (header x-estufa-token)
# Se ficar vazio, o endpoint aceita apenas em ambiente de demonstracao.
ESTUFA_TOKEN=

# ============================================================
# AgroSmart — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local (ele está no .gitignore).
# ============================================================

# ---------- IA ----------
# Provedor: gemini | deepseek | groq
# Para diagnóstico de imagem, recomenda-se o Gemini (visão).
IA_PROVIDER=gemini

# Google Gemini
# Onde conseguir: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
# Onde conseguir: https://platform.deepseek.com -> API Keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq
# Onde conseguir: https://console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Estufa / ESP32 ----------
# Token opcional que o ESP32 envia no header x-estufa-token.
# Se ficar vazio, o endpoint aceita apenas em ambiente de demonstração.
ESTUFA_TOKEN=

# ---------- Bridge serial (firmware/bridge-serial) ----------
# Porta serial do Arduino/ESP32 (Windows: COM3; Linux: /dev/ttyUSB0).
SERIAL_PORT=COM3
# Velocidade da serial (a mesma configurada no firmware).
SERIAL_BAUD=9600
# URL que o bridge chama para enviar as leituras.
API_URL=http://localhost:3000/api/estufa/leituras

# Banco local (ou Turso em produção)
DATABASE_URL=file:./data/sabor.db
DATABASE_AUTH_TOKEN=

# Pix: use a chave real da cantina (CPF, CNPJ, e-mail, telefone ou aleatória)
# Sem PIX_KEY, o caixa funciona com cartão e dinheiro, mas não gera o QR real.
PIX_KEY=
PIX_MERCHANT_NAME=SABOR DO FLORESTAN
PIX_MERCHANT_CITY=TERESINA

# Segredo opcional para ações administrativas (não usado no app por padrão)
# ADMIN_PIN=

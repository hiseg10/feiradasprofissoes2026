# ============================================================
# Sabor do Florestan — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local (ele está no .gitignore).
# ============================================================

# ---------- Banco de dados ----------
# Local (desenvolvimento): arquivo SQLite na pasta data/.
# Produção (Vercel): use a URL do Turso (libsql://...).
# Onde conseguir (Turso): https://turso.tech -> seu banco -> Connect
#   -> copie a URL (DATABASE_URL) e gere um token (DATABASE_AUTH_TOKEN).
DATABASE_URL=file:./data/sabor.db
DATABASE_AUTH_TOKEN=

# ---------- Pix ----------
# Chave Pix que RECEBE os pagamentos: CPF, CNPJ, e-mail, telefone ou aleatória.
# Use a chave combinada com a equipe/cantina (evite chave pessoal).
# Onde conseguir: no app do seu banco (área Pix) ou no Mercado Pago.
PIX_KEY=
# Nome do recebedor (até 25 caracteres) e cidade (até 15) exibidos no QR.
PIX_MERCHANT_NAME=SABOR DO FLORESTAN
PIX_MERCHANT_CITY=TERESINA

# ---------- Mercado Pago (cartão online e Google Pay) ----------
# Onde conseguir:
#   https://www.mercadopago.com.br/developers/panel/app
#   -> sua aplicação -> Credenciais de teste (ou produção)
# Public Key: pode ser exposta ao navegador. O prefixo NEXT_PUBLIC_ é obrigatório.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Access Token: SEGREDO. Fica só no servidor. NUNCA use prefixo NEXT_PUBLIC_.
MP_ACCESS_TOKEN=
# Opcional: valida a assinatura dos webhooks.
# Onde conseguir: sua aplicação -> Webhooks -> chave secreta.
MP_WEBHOOK_SECRET=

# ---------- Mercado Pago: credenciais de TESTE (opcional) ----------
# Use no escopo Preview da Vercel para testar sem trocar as chaves de produção.
# Se preenchidas, têm prioridade sobre as variáveis acima.
MP_ACCESS_TOKEN_TEST=
NEXT_PUBLIC_MP_PUBLIC_KEY_TEST=

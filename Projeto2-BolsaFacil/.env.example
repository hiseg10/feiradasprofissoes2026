# Dados de mercado (brapi.dev). Crie uma conta gratuita em https://brapi.dev
# Sem token, o app usa dados de demonstracao.
BRAPI_TOKEN=

# Provedor de IA: gemini | deepseek | groq
IA_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

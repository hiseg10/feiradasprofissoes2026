# ============================================================
# CDQ — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local (ele está no .gitignore).
# ============================================================

# ---------- Banco de dados ----------
# Local (desenvolvimento): arquivo SQLite.
# Produção (Vercel): use a URL do Turso (libsql://...).
# Onde conseguir (Turso): https://turso.tech -> seu banco -> Connect
#   -> copie a URL (DATABASE_URL) e gere um token (DATABASE_AUTH_TOKEN).
DATABASE_URL=file:./data/cdq.db
DATABASE_AUTH_TOKEN=

# ---------- Sessão ----------
# Gere uma string aleatória longa, ex.: openssl rand -base64 32
AUTH_SECRET=troque-por-uma-string-aleatoria-longa

# ---------- Login com Google ----------
# Onde conseguir: https://console.cloud.google.com
#   -> APIs & Services -> Credentials -> Create Credentials -> OAuth 2.0 Client
# Redirect URI: https://SEU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Administradores ----------
# E-mails que entram como administradores (separados por vírgula).
ADMIN_EMAILS=admin@cdq.local

# ---------- Desenvolvimento ----------
# 1 = habilita o botão "Entrar como admin (dev)". Use 0 em produção.
DEV_LOGIN=1

# ---------- Upload de fotos ----------
# Onde conseguir: Vercel -> Storage -> Blob -> Read/Write Token.
# Sem isso, as fotos são salvas em public/uploads (apenas local).
BLOB_READ_WRITE_TOKEN=

# ---------- Dados de exemplo ----------
# 1 = popula dados de demonstração; 0 = não popula.
SEED_DEMO=0
